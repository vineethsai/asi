{
  "name": "owasp-agentic-security",
  "private": true,
  "version": "2.0.0",
  "description": "Interactive guide for securing AI agentic applications using OWASP best practices",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://agenticsecurity.info/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "preview": "vite preview",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run check:data && npm run check:rules && npm run test && npm run build",
    "postbuild": "cp docs/index.html docs/404.html && node scripts/generate-seo.js && node scripts/prerender.mjs",
    "check:data": "node scripts/check-data-integrity.js",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:aisvs": "node scripts/import-aisvs.mjs",
    "counts": "node scripts/print-counts.mjs",
    "generate:seo": "node scripts/generate-seo.js",
    "prerender": "node scripts/prerender.mjs",
    "check:rules": "node scripts/check-rules.js"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "src/**/*.{css,json}": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@xyflow/react": "^12.10.0",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "d3": "^7.9.0",
    "d3-sankey": "0.12.3",
    "geist": "1.7.0",
    "html-to-image": "^1.11.13",
    "jspdf": "4.1.0",
    "jspdf-autotable": "5.0.7",
    "lucide-react": "^0.462.0",
    "lz-string": "1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^6.26.2",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/canvas-confetti": "1.9.0",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "0.12.5",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "satori": "0.63.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22.22"
  }
}
